          "request": {
            "name": "List appointments",
            "description": {
              "content": "Get a list of appointments currently scheduled for the authenticated user.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "appointments"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "max",
                  "value": "100",
                  "description": "Maximum number of results"
                },
                {
                  "disabled": false,
                  "key": "minDate",
                  "value": "<date>",
                  "description": "Only get appointments this date and after"
                },
                {
                  "disabled": false,
                  "key": "maxDate",
                  "value": "<date>",
                  "description": "Only get appointments this date and before"
                },
                {
                  "disabled": false,
                  "key": "calendarID",
                  "value": "<integer>",
                  "description": "Show only appointments on calendar with specified ID"
                },
                {
                  "disabled": false,
                  "key": "appointmentTypeID",
                  "value": "<integer>",
                  "description": "Show only appointments of this type"
                },
                {
                  "disabled": false,
                  "key": "canceled",
                  "value": "false",
                  "description": "Get canceled appointments (include noShow field in response)"
                },
                {
                  "disabled": false,
                  "key": "showall",
