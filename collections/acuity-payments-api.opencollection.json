{
  "opencollection": "1.0.0",
  "info": {
    "name": "Acuity Scheduling Appointments Payments API",
    "version": "1.1"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Payments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get appointment payments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://acuityscheduling.com/api/v1/appointments/:id/payments",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Appointment ID"
              }
            ]
          },
          "docs": "Retrieve a list of payment transactions for a particular appointment."
        }
      ]
    }
  ],
  "bundled": true
}